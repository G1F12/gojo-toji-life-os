{
  "name": "gojo-toji-life-os",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "hebece": "0.2.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --outfile=assets/life-data.js && node scripts/prepare-public.mjs",
    "check": "node --check api/school/sync.js && node --check api/school/calendar.js && node scripts/check-inline.mjs"
  }
}
