# Recommended: protect your personal school endpoint
LIFE_OS_API_TOKEN=change-this-long-random-token

# Choose one provider:
SCHOOL_PROVIDER=hebece
# SCHOOL_PROVIDER=feed

# HebeCE mode (no eduVULCAN password is stored in the PWA)
EDUVULCAN_API_AP=
EDUVULCAN_KEYPAIR_JSON=
# Optional when account contains multiple pupils
EDUVULCAN_PUPIL_ID=

# Feed/bridge mode (e.g. a private vulcan-notify compatible JSON endpoint)
# SCHOOL_FEED_URL=https://your-private-bridge.example/api/life-os
# SCHOOL_FEED_TOKEN=

# Unsafe fallback for local testing only; do NOT use in public production:
# LIFE_OS_ALLOW_UNAUTHENTICATED=true
